# Turso values are configured as hosted environment variables, never committed.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-database-token
# Server-side shared routing. DeepSeek handles routine work; OpenAI handles
# sourced web research and strategic planning. Never expose these to browsers.
DEEPSEEK_API_KEY=your-deepseek-api-key
OPENAI_API_KEY=your-openai-api-key
# Local-only test switch. Never configure this in production.
ALLOW_DEV_IDENTITY=true
# Paired desktop runner beta. Apply migrations 007-008 and validate locally before enabling.
RUNNER_ENABLED=false
